// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

enum UserRole {
  ADMIN
  SUBADMIN
  MANAGER
}

enum ProjectStatus {
  BUDGET      // Borrador/presupuesto
  ACTIVE      // Proyecto aceptado
  IN_PROCESS  // En proceso
  FINISHED    // Finalizado
  DELETED     // Eliminado (soft delete lógico)
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String
  lastName  String
  role      UserRole  @default(MANAGER)
  isActive  Boolean   @default(true)
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  audits    AuditLog[]

  @@map("users")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action      String   // CREATE, UPDATE, DELETE, etc.
  entity      String   // Entity name (User, Budget, etc.)
  entityId    String   // ID of the affected entity
  changes     Json?    // Store the actual changes
  
  ip          String
  location    String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Client {
  id        String    @id @default(uuid())
  fullname  String
  phone     String
  cuit      String?   // CUIT sin formato, solo números o string
  dni       String?   // DNI - uno de los dos debe ser obligatorio (validar en DTO)
  
  projects  Project[]
  budgets   Budget[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("clients")
  @@index([cuit])
  @@index([dni])
}

model Project {
  id          String         @id @default(uuid())
  amount      Float          // Total a pagar
  totalPaid   Float          @default(0) // Total pagado hasta ahora
  rest        Float          // Restante a pagar (se puede calcular)
  
  status      ProjectStatus  @default(BUDGET) // Estado del proyecto
  usdPrice    Json?          // Precio del dólar cuando se activa (JSONB)
  event       String?        // Evento relacionado al proyecto
  items       ProjectItem[]
  
  collaborators ProjectCollaborator[]

  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  
  // Ubicación del proyecto (compatible con Leaflet y Google Maps)
  locationAddress  String?   // Dirección legible
  locationLat      Float?    // Latitud
  locationLng      Float?    // Longitud
  
  workers     Int            // Cantidad de personal necesario
  dateInit    DateTime       // Fecha de inicio del proyecto
  dateEnd     DateTime       // Fecha de finalización del proyecto
  
  paids       Paid[]         // Pagos realizados
  dispatches  Dispatch[]     // Remitos de despacho

  hasUSD      Boolean        @default(false)  // Si el proyecto está cotizado en USD
  usdValue    Float?         // Valor del dólar utilizado
  amountUSD   Float?         // Monto total en USD
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@map("projects")
  @@index([clientId])
  @@index([status])
  @@index([dateInit])
  @@index([dateEnd])
}

model Paid {
  id          String    @id @default(uuid())
  number      String?   @unique // Numeración secuencial: 001-00001
  amount      Float     // Monto del pago
  date        DateTime  // Fecha del pago
  bill        String    @default("") // Código de factura relacionada
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  hasUSD      Boolean        @default(false)  // Si el pago está cotizado en USD
  usdValue    Float?         // Valor del dólar al momento del pago
  amountUSD   Float?         // Monto total en USD
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("paids")
  @@index([projectId])
  @@index([date])
  @@index([number])
}

model Staff{
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  dni       String?   // DNI - uno de los dos debe ser obligatorio (validar en DTO) 
  cuit      String?   // CUIT sin formato, solo números o string
  category  String    // Categoría del personal 
  numberPhone String?
  adress      String?
  email       String?
  seniority   String?

  workRecords  WorkRecord[]
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model WorkRecord {
  id             String    @id @default(uuid())
  
  advance        Float     // "Adelanto"
  total          Float     // Total = Suma de lo pagado por las horas - Adelanto
  
  //HOURSDAY basicamente es el monto que se le paga el empleado ese dia, mas no las horas trabajadas (En un principio era Hours * ValuePerHour)
  hoursMonday    Float
  hoursTuesday   Float
  hoursWednesday Float
  hoursThursday  Float
  hoursFriday    Float
  hoursSaturday  Float  /// Luego borrar registros viejos para sacar este campo como Opcional y que pase a ser obligatorio
  hoursSunday    Float

  //Horas extras que se pagan 
  hoursMondayExtra    Float
  hoursTuesdayExtra   Float
  hoursWednesdayExtra Float
  hoursThursdayExtra  Float
  hoursFridayExtra    Float
  hoursSaturdayExtra  Float  /// Luego borrar registros viejos para sacar este campo como Opcional y que pase a ser obligatorio
  hoursSundayExtra    Float

  //Campo viernesExtra semana pasada 
  hoursFridayLastWeek Float?

  //Horas extras que hacen el sabado o viernes, se lo pagan en la proxima liquidacion, por ende se agrega un campo mas
  hoursLastWeek       Float
  
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id])

  expense     Expense?
  
  startDate      DateTime // Por ejemplo, el lunes de la semana
  endDate        DateTime // Por ejemplo, el viernes o domingo de la semana. Sirve por si quiere la liquidacion de un mes completo en algun momento

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt DateTime?
}

model StructureCategory {
  id          String    @id @default(uuid())
  name        String
  description String?

  structures  Structure[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@map("structure_categories")
}

model Structure {
  id             String    @id @default(uuid())
  name           String 
  categoryId     String
  category       StructureCategory @relation(fields: [categoryId], references: [id])
  stock          Float      //STOCK DISPONIBLE
  measure        String?    //Ej: "1,85x1M", "6,40mts", "30x30cm"
  description    String?    //Descripcion de la estructura

  items           ProjectItem[]  //Mapea a los proyectos que usan esta estructura
  budgetItems     BudgetItem[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
}

model ProjectItem {
  id          String    @id @default(uuid())
  quantity    Int       // Cantidad asignada a este proyecto específico
  dispatchedQuantity Int @default(0) // Cantidad ya despachada
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  structureId String
  structure   Structure @relation(fields: [structureId], references: [id])

  dispatchItems  DispatchItem[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([projectId, structureId])
}



model Budget {
  id             String    @id @default(uuid())
  
  date           DateTime  @default(now()) 
  
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id])
  
  manualClientName String?
  manualClientCuit String? 
  
  items          BudgetItem[]
  descriptionItems BudgetDescriptionItem[]

  netAmount      Float     // Valor neto (Suma de items * precio)
  
  hasIva         Boolean   @default(false)
  ivaPercentage  Float?    // 0, 5, 10.5, 21 (Se guarda el % seleccionado)
  ivaValue       Float?    // El valor monetario calculado del IVA
  
  hasIibb        Boolean   @default(false)
  iibbPercentage Float?    // 1, 2, 3, 4, 5 (Se guarda el % seleccionado)
  iibbValue      Float?    // El valor monetario calculado de IIBB

  hasUSD         Boolean   @default(false)
  usdValue       Float?    // El valor monetario de USD
  totalAmountUSD Float?    // El valor monetario total en USD

  totalAmount    Float     // Total Final = netAmount + iva + iibb

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? 
  
  @@map("budgets")
}

model BudgetItem {
  id             String    @id @default(uuid())
  
  quantity       Int       
     
  budgetId       String
  budget         Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  structureId    String?
  structure      Structure? @relation(fields: [structureId], references: [id])
  
  manualName     String?   

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("budget_items")
}

model BudgetDescriptionItem {
  id             String    @id @default(uuid())
  
  title          String
  quantity       Int       @default(1) // Cantidad (opcional, por defecto 1 si no se usa)
  price          Float     // Precio unitario
  unit           String?   // Unidad (e.g. "Por hora", "Global", "m2") -> Opcional
  
  budgetId       String
  budget         Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("budget_description_items")
}

model Collaborator{                               //VALIDACIONES MUY IMPORTANTES EN DTO
  id             String    @id @default(uuid())
  
  firstName      String?
  lastName       String?
  notes          String?

  projects       ProjectCollaborator[]

  companyName    String? ///Razon social
  dni            String?
  cuit           String?

  quantityWorkers  Float      // Cantidad de personal que pueden aportar
  valuePerHour     Float      //VALOR POR HORA DEL PERSONAL QUE SE APORTA

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@map("collaborators")
}

model ProjectCollaborator {
  id             String        @id @default(uuid())
  
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  collaboratorId String
  collaborator   Collaborator  @relation(fields: [collaboratorId], references: [id])

  workersCount   Int           // Cantidad de empleados asignados para este proyecto
  hoursCount     Float         // Cantidad de horas estimadas/necesarias
  valuePerHour   Float         // Snapshot: Precio por hora pactado en el momento de la asignación
  
  totalCost      Float         

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([projectId, collaboratorId]) // Para evitar duplicar el mismo colaborador en el mismo proyecto
  @@map("project_collaborators")
}

model ExpenseCategory{
  id             String    @id @default(uuid())
  name           String
  description    String?

  expenses      Expense[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Expense{
  id                  String    @id @default(uuid())
  description         String
  amount              Float
  date                DateTime @default(now())      //Fecha en que se realizo el gasto, mas no se creo.
  
  categoryId          String
  category            ExpenseCategory @relation(fields: [categoryId], references: [id])

  workRecordId      String?  @unique // Opcional: Relacion 1 a 1 con la planilla
  workRecord        WorkRecord? @relation(fields: [workRecordId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Dispatch{
  id                  String    @id @default(uuid())
  dispatchNumber      Int       @unique @default(autoincrement())   // Para pdf principalmente
  
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id])
  
  firstName           String
  lastName            String
  cuit                String
  licensePlate        String
  notes               String?

  items               DispatchItem[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([projectId])
  @@map("dispatches")
}

model DispatchItem {
  id          String    @id @default(uuid())
  
  quantity    Float       // CANTIDAD DE ESTA ESTRUCTURA QUE SE ENVIAN
  
  dispatchId  String
  dispatch    Dispatch  @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  
  projectItemId String
  projectItem   ProjectItem @relation(fields: [projectItemId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  
  @@unique([dispatchId, projectItemId])
  @@map("dispatch_items")
}

